# Copy to .env (or just run `npm run setup`, which generates one for you).
NODE_ENV=development
API_PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL="file:./dev.db"

# 48+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Optional SMTP. Leave SMTP_HOST empty to use the built-in development mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Digital Legacy Manager <no-reply@example.com>"

# Demo helpers (mailbox page, time travel). Defaults to on in development, off in production.
# ENABLE_DEV_TOOLS=false
